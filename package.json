{
  "name": "concert-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "tsc -b && vite build",
    "benchmark:import": "tsx scripts/benchmark-import.ts",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "test:db": "node scripts/test-db.mjs",
    "test": "vitest",
    "deploy:setup": "npx vercel login && npx vercel link",
    "deploy": "npm run check:server && npm run test -- --run && npx vercel pull --environment=production && npx vercel build --prod && npx vercel deploy --prebuilt --prod"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@vercel/functions": "^3.9.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.18.2",
    "react-youtube": "^10.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vercel/node": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^27.0.0",
    "pg": "^8.23.0",
    "supabase": "^2.115.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vercel": "^59.5.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "24.x"
  }
}
